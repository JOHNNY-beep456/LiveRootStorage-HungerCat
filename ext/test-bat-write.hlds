{
  "id": "lrs.test.bat-write",
  "name": "Bat写入测试 / Bat Write Test",
  "version": "1.0.0",
  "type": "lrs-extension",
  "author": "LRS Team",
  "description": "测试LRS能否通过cmd echo写出bat文件。点击按钮后：1) 写入bat到%TEMP%\\lrs_test.bat 2) 显示bat内容 3) 运行bat。",
  "entry": "cmd.exe /c echo test",
  "points": {
    "topbar_buttons": [
      {
        "id": "write-and-show-bat",
        "label": "🧪 Bat写入测试",
        "command": "cmd.exe /c > \"%TEMP%\\lrs_test.bat\" echo @echo off & >> \"%TEMP%\\lrs_test.bat\" echo setlocal & >> \"%TEMP%\\lrs_test.bat\" echo set X=Hello_from_bat & > \"%TEMP%\\lrs_test_out.txt\" echo ===== LRS Bat Write Test ===== & >> \"%TEMP%\\lrs_test_out.txt\" echo Bat file written to: %TEMP%\\lrs_test.bat & >> \"%TEMP%\\lrs_test_out.txt\" echo Running the bat... & >> \"%TEMP%\\lrs_test_out.txt\" echo. & call \"%TEMP%\\lrs_test.bat\" >> \"%TEMP%\\lrs_test_out.txt\" 2>&1 & >> \"%TEMP%\\lrs_test_out.txt\" echo. & >> \"%TEMP%\\lrs_test_out.txt\" echo ===== Bat output above ===== & >> \"%TEMP%\\lrs_test_out.txt\" echo X = %X% & notepad \"%TEMP%\\lrs_test_out.txt\"",
        "position": 998
      }
    ]
  }
}
