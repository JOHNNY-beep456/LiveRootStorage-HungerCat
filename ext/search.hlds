{
  "id": "lrs.builtin.search",
  "name": "搜索文件 / File Search",
  "version": "2.0.0",
  "type": "lrs-extension",
  "author": "LRS Team",
  "description": "JScript + cscript 自包含搜索；不依赖 PowerShell。搜索结果写到 %TEMP%\\lrs_search_results.txt 并 Notepad 打开。",
  "entry": "cmd.exe /c \"echo >%TEMP%\\lrs_search.b64 & certutil -decode -f %TEMP%\\lrs_search.b64 %TEMP%\\lrs_search.js >NUL & cscript //NoLogo %TEMP%\\lrs_search.js\"",
  "points": {
    "topbar_buttons": [
      {
        "id": "search-current",
        "label": "🔍 搜索",
        "command": "cmd.exe /c \"echo >%TEMP%\\lrs_search.b64 & certutil -decode -f %TEMP%\\lrs_search.b64 %TEMP%\\lrs_search.js >NUL & cscript //NoLogo %TEMP%\\lrs_search.js \"%D\"\"",
        "position": 10
      }
    ],
    "context_menu": [
      {
        "id": "search-in-folder",
        "label": "在此文件夹中搜索…",
        "applyTo": "Folder",
        "command": "cmd.exe /c \"echo >%TEMP%\\lrs_search.b64 & certutil -decode -f %TEMP%\\lrs_search.b64 %TEMP%\\lrs_search.js >NUL & cscript //NoLogo %TEMP%\\lrs_search.js \"%F\"\""
      },
      {
        "id": "search-background",
        "label": "在当前文件夹搜索…",
        "applyTo": "Background",
        "command": "cmd.exe /c \"echo >%TEMP%\\lrs_search.b64 & certutil -decode -f %TEMP%\\lrs_search.b64 %TEMP%\\lrs_search.js >NUL & cscript //NoLogo %TEMP%\\lrs_search.js \"%D\"\""
      },
      {
        "id": "search-by-name",
        "label": "搜索同名文件",
        "applyTo": "File",
        "command": "cmd.exe /c \"echo >%TEMP%\\lrs_search.b64 & certutil -decode -f %TEMP%\\lrs_search.b64 %TEMP%\\lrs_search.js >NUL & cscript //NoLogo %TEMP%\\lrs_search.js \"%D\" \"%F\"\""
      }
    ],
    "file_columns": [
      {
        "id": "search_extension_col",
        "header": "扩展名",
        "value": "extension",
        "width": 0.8
      },
      {
        "id": "search_path_col",
        "header": "完整路径",
        "value": "path",
        "width": 2.0
      }
    ],
    "settings": [
      {
        "key": "maxResults",
        "label": "最大结果数",
        "type": "number",
        "default": "1000"
      },
      {
        "key": "defaultScope",
        "label": "默认搜索范围（UI 占位）",
        "type": "combo",
        "default": "current",
        "options": [
          "current",
          "libraries",
          "computer"
        ]
      }
    ]
  }
}