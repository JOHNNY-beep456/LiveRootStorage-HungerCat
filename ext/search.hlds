{
  "id": "lrs.builtin.search",
  "name": "搜索文件 / File Search",
  "version": "1.1.0",
  "type": "lrs-extension",
  "author": "LRS Team",
  "description": "通过 PowerShell 在指定目录递归搜索文件名，结果用 WPF DataGrid 显示在脚本进程内（不调起资源管理器）。",
  "entry": "powershell.exe -NoProfile -File ext\\search.ps1",
  "points": {
    "topbar_buttons": [
      {
        "id": "search-current",
        "label": "🔍 搜索",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"ext\\search.ps1\" -SearchDir \"%D\"",
        "position": 10
      }
    ],
    "context_menu": [
      {
        "id": "search-in-folder",
        "label": "在此文件夹中搜索…",
        "applyTo": "Folder",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"ext\\search.ps1\" -SearchDir \"%F\""
      },
      {
        "id": "search-background",
        "label": "在当前文件夹搜索…",
        "applyTo": "Background",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"ext\\search.ps1\" -SearchDir \"%D\""
      },
      {
        "id": "search-by-name",
        "label": "搜索同名文件",
        "applyTo": "File",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"ext\\search.ps1\" -SearchDir \"%D\" -PresetFilePath \"%F\""
      }
    ],
    "file_columns": [
      {
        "id": "search_extension_col",
        "header": "扩展名",
        "value": "extension",
        "width": 0.8
      },
      {
        "id": "search_path_col",
        "header": "完整路径",
        "value": "path",
        "width": 2.0
      }
    ],
    "settings": [
      {
        "key": "maxResults",
        "label": "最大结果数（脚本内限制）",
        "type": "number",
        "default": "1000"
      },
      {
        "key": "defaultScope",
        "label": "默认搜索范围（UI 占位）",
        "type": "combo",
        "default": "current",
        "options": ["current", "libraries", "computer"]
      },
      {
        "key": "rememberLastQuery",
        "label": "记住上次搜索词",
        "type": "toggle",
        "default": "true"
      }
    ]
  }
}
