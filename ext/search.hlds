{
  "id": "lrs.builtin.search",
  "name": "搜索文件 / File Search",
  "version": "3.0.0",
  "type": "lrs-extension",
  "author": "LRS Team",
  "description": "纯 cmd + start 新窗口：set /p 输入关键词，for /r 递归搜索，notepad 显示结果。无 PowerShell、无 JScript、无 base64。",
  "entry": "cmd.exe /c echo search",
  "points": {
    "topbar_buttons": [
      {
        "id": "search-current",
        "label": "🔍 搜索",
        "command": "cmd.exe /c > \"%TEMP%\\lrs_search.bat\" echo @echo off & >> \"%TEMP%\\lrs_search.bat\" echo setlocal & >> \"%TEMP%\\lrs_search.bat\" echo set \"ARG=%~1\" & >> \"%TEMP%\\lrs_search.bat\" echo set \"DIR=\" & >> \"%TEMP%\\lrs_search.bat\" echo set \"TERM=\" & >> \"%TEMP%\\lrs_search.bat\" echo if \"%ARG%\"==\"\" goto noarg & >> \"%TEMP%\\lrs_search.bat\" echo if exist \"%ARG%\\\" goto isdir & >> \"%TEMP%\\lrs_search.bat\" echo rem --- file path: derive parent dir and base name --- & >> \"%TEMP%\\lrs_search.bat\" echo for %%F in (\"%ARG%\") do set \"DIR=%%~dpF\" & >> \"%TEMP%\\lrs_search.bat\" echo for %%F in (\"%ARG%\") do set \"TERM=%%~nF\" & >> \"%TEMP%\\lrs_search.bat\" echo goto resolved & >> \"%TEMP%\\lrs_search.bat\" echo :isdir & >> \"%TEMP%\\lrs_search.bat\" echo set \"DIR=%ARG%\" & >> \"%TEMP%\\lrs_search.bat\" echo goto resolved & >> \"%TEMP%\\lrs_search.bat\" echo :noarg & >> \"%TEMP%\\lrs_search.bat\" echo set \"DIR=%CD%\" & >> \"%TEMP%\\lrs_search.bat\" echo :resolved & >> \"%TEMP%\\lrs_search.bat\" echo if not defined DIR set \"DIR=%CD%\" & >> \"%TEMP%\\lrs_search.bat\" echo if defined TERM goto doterm & >> \"%TEMP%\\lrs_search.bat\" echo set /p \"TERM=Enter search term (in %DIR%): \" & >> \"%TEMP%\\lrs_search.bat\" echo :doterm & >> \"%TEMP%\\lrs_search.bat\" echo if not defined TERM exit /b & >> \"%TEMP%\\lrs_search.bat\" echo set \"OUT=%TEMP%\\lrs_search_results.txt\" & >> \"%TEMP%\\lrs_search.bat\" echo >  \"%OUT%\" echo ===== LRS Search ===== & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo Directory: %DIR% & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo Term:      %TERM% & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo ==================== & >> \"%TEMP%\\lrs_search.bat\" echo for /r \"%DIR%\" %%F in (*%TERM%*) do >> \"%OUT%\" echo %%~fF & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo ===== done ===== & >> \"%TEMP%\\lrs_search.bat\" echo notepad \"%OUT%\" & start \"LRS Search\" cmd /C \"%TEMP%\\lrs_search.bat\" \"%D%\"",
        "position": 10
      }
    ],
    "context_menu": [
      {
        "id": "search-in-folder",
        "label": "在此文件夹中搜索…",
        "applyTo": "Folder",
        "command": "cmd.exe /c > \"%TEMP%\\lrs_search.bat\" echo @echo off & >> \"%TEMP%\\lrs_search.bat\" echo setlocal & >> \"%TEMP%\\lrs_search.bat\" echo set \"ARG=%~1\" & >> \"%TEMP%\\lrs_search.bat\" echo set \"DIR=\" & >> \"%TEMP%\\lrs_search.bat\" echo set \"TERM=\" & >> \"%TEMP%\\lrs_search.bat\" echo if \"%ARG%\"==\"\" goto noarg & >> \"%TEMP%\\lrs_search.bat\" echo if exist \"%ARG%\\\" goto isdir & >> \"%TEMP%\\lrs_search.bat\" echo rem --- file path: derive parent dir and base name --- & >> \"%TEMP%\\lrs_search.bat\" echo for %%F in (\"%ARG%\") do set \"DIR=%%~dpF\" & >> \"%TEMP%\\lrs_search.bat\" echo for %%F in (\"%ARG%\") do set \"TERM=%%~nF\" & >> \"%TEMP%\\lrs_search.bat\" echo goto resolved & >> \"%TEMP%\\lrs_search.bat\" echo :isdir & >> \"%TEMP%\\lrs_search.bat\" echo set \"DIR=%ARG%\" & >> \"%TEMP%\\lrs_search.bat\" echo goto resolved & >> \"%TEMP%\\lrs_search.bat\" echo :noarg & >> \"%TEMP%\\lrs_search.bat\" echo set \"DIR=%CD%\" & >> \"%TEMP%\\lrs_search.bat\" echo :resolved & >> \"%TEMP%\\lrs_search.bat\" echo if not defined DIR set \"DIR=%CD%\" & >> \"%TEMP%\\lrs_search.bat\" echo if defined TERM goto doterm & >> \"%TEMP%\\lrs_search.bat\" echo set /p \"TERM=Enter search term (in %DIR%): \" & >> \"%TEMP%\\lrs_search.bat\" echo :doterm & >> \"%TEMP%\\lrs_search.bat\" echo if not defined TERM exit /b & >> \"%TEMP%\\lrs_search.bat\" echo set \"OUT=%TEMP%\\lrs_search_results.txt\" & >> \"%TEMP%\\lrs_search.bat\" echo >  \"%OUT%\" echo ===== LRS Search ===== & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo Directory: %DIR% & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo Term:      %TERM% & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo ==================== & >> \"%TEMP%\\lrs_search.bat\" echo for /r \"%DIR%\" %%F in (*%TERM%*) do >> \"%OUT%\" echo %%~fF & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo ===== done ===== & >> \"%TEMP%\\lrs_search.bat\" echo notepad \"%OUT%\" & start \"LRS Search\" cmd /C \"%TEMP%\\lrs_search.bat\" \"%F%\""
      },
      {
        "id": "search-background",
        "label": "在当前文件夹搜索…",
        "applyTo": "Background",
        "command": "cmd.exe /c > \"%TEMP%\\lrs_search.bat\" echo @echo off & >> \"%TEMP%\\lrs_search.bat\" echo setlocal & >> \"%TEMP%\\lrs_search.bat\" echo set \"ARG=%~1\" & >> \"%TEMP%\\lrs_search.bat\" echo set \"DIR=\" & >> \"%TEMP%\\lrs_search.bat\" echo set \"TERM=\" & >> \"%TEMP%\\lrs_search.bat\" echo if \"%ARG%\"==\"\" goto noarg & >> \"%TEMP%\\lrs_search.bat\" echo if exist \"%ARG%\\\" goto isdir & >> \"%TEMP%\\lrs_search.bat\" echo rem --- file path: derive parent dir and base name --- & >> \"%TEMP%\\lrs_search.bat\" echo for %%F in (\"%ARG%\") do set \"DIR=%%~dpF\" & >> \"%TEMP%\\lrs_search.bat\" echo for %%F in (\"%ARG%\") do set \"TERM=%%~nF\" & >> \"%TEMP%\\lrs_search.bat\" echo goto resolved & >> \"%TEMP%\\lrs_search.bat\" echo :isdir & >> \"%TEMP%\\lrs_search.bat\" echo set \"DIR=%ARG%\" & >> \"%TEMP%\\lrs_search.bat\" echo goto resolved & >> \"%TEMP%\\lrs_search.bat\" echo :noarg & >> \"%TEMP%\\lrs_search.bat\" echo set \"DIR=%CD%\" & >> \"%TEMP%\\lrs_search.bat\" echo :resolved & >> \"%TEMP%\\lrs_search.bat\" echo if not defined DIR set \"DIR=%CD%\" & >> \"%TEMP%\\lrs_search.bat\" echo if defined TERM goto doterm & >> \"%TEMP%\\lrs_search.bat\" echo set /p \"TERM=Enter search term (in %DIR%): \" & >> \"%TEMP%\\lrs_search.bat\" echo :doterm & >> \"%TEMP%\\lrs_search.bat\" echo if not defined TERM exit /b & >> \"%TEMP%\\lrs_search.bat\" echo set \"OUT=%TEMP%\\lrs_search_results.txt\" & >> \"%TEMP%\\lrs_search.bat\" echo >  \"%OUT%\" echo ===== LRS Search ===== & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo Directory: %DIR% & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo Term:      %TERM% & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo ==================== & >> \"%TEMP%\\lrs_search.bat\" echo for /r \"%DIR%\" %%F in (*%TERM%*) do >> \"%OUT%\" echo %%~fF & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo ===== done ===== & >> \"%TEMP%\\lrs_search.bat\" echo notepad \"%OUT%\" & start \"LRS Search\" cmd /C \"%TEMP%\\lrs_search.bat\" \"%D%\""
      },
      {
        "id": "search-by-name",
        "label": "搜索同名文件",
        "applyTo": "File",
        "command": "cmd.exe /c > \"%TEMP%\\lrs_search.bat\" echo @echo off & >> \"%TEMP%\\lrs_search.bat\" echo setlocal & >> \"%TEMP%\\lrs_search.bat\" echo set \"ARG=%~1\" & >> \"%TEMP%\\lrs_search.bat\" echo set \"DIR=\" & >> \"%TEMP%\\lrs_search.bat\" echo set \"TERM=\" & >> \"%TEMP%\\lrs_search.bat\" echo if \"%ARG%\"==\"\" goto noarg & >> \"%TEMP%\\lrs_search.bat\" echo if exist \"%ARG%\\\" goto isdir & >> \"%TEMP%\\lrs_search.bat\" echo rem --- file path: derive parent dir and base name --- & >> \"%TEMP%\\lrs_search.bat\" echo for %%F in (\"%ARG%\") do set \"DIR=%%~dpF\" & >> \"%TEMP%\\lrs_search.bat\" echo for %%F in (\"%ARG%\") do set \"TERM=%%~nF\" & >> \"%TEMP%\\lrs_search.bat\" echo goto resolved & >> \"%TEMP%\\lrs_search.bat\" echo :isdir & >> \"%TEMP%\\lrs_search.bat\" echo set \"DIR=%ARG%\" & >> \"%TEMP%\\lrs_search.bat\" echo goto resolved & >> \"%TEMP%\\lrs_search.bat\" echo :noarg & >> \"%TEMP%\\lrs_search.bat\" echo set \"DIR=%CD%\" & >> \"%TEMP%\\lrs_search.bat\" echo :resolved & >> \"%TEMP%\\lrs_search.bat\" echo if not defined DIR set \"DIR=%CD%\" & >> \"%TEMP%\\lrs_search.bat\" echo if defined TERM goto doterm & >> \"%TEMP%\\lrs_search.bat\" echo set /p \"TERM=Enter search term (in %DIR%): \" & >> \"%TEMP%\\lrs_search.bat\" echo :doterm & >> \"%TEMP%\\lrs_search.bat\" echo if not defined TERM exit /b & >> \"%TEMP%\\lrs_search.bat\" echo set \"OUT=%TEMP%\\lrs_search_results.txt\" & >> \"%TEMP%\\lrs_search.bat\" echo >  \"%OUT%\" echo ===== LRS Search ===== & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo Directory: %DIR% & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo Term:      %TERM% & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo ==================== & >> \"%TEMP%\\lrs_search.bat\" echo for /r \"%DIR%\" %%F in (*%TERM%*) do >> \"%OUT%\" echo %%~fF & >> \"%TEMP%\\lrs_search.bat\" echo >> \"%OUT%\" echo ===== done ===== & >> \"%TEMP%\\lrs_search.bat\" echo notepad \"%OUT%\" & start \"LRS Search\" cmd /C \"%TEMP%\\lrs_search.bat\" \"%F%\""
      }
    ],
    "file_columns": [
      {
        "id": "search_extension_col",
        "header": "扩展名",
        "value": "extension",
        "width": 0.8
      },
      {
        "id": "search_path_col",
        "header": "完整路径",
        "value": "path",
        "width": 2.0
      }
    ],
    "settings": [
      {
        "key": "maxResults",
        "label": "最大结果数",
        "type": "number",
        "default": "1000"
      }
    ]
  }
}
