<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LRS.Views.TopView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LRS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:BBB="using:BetterBreadcrumbBar.Control"
	xmlns:vm="using:LRS.ViewModels"
	xmlns:services="using:LRS.Services"
	xmlns:LRSCtrls="using:LRS.UserControls"
	d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    mc:Ignorable="d">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>
		<LRSCtrls:LRSBreadcrumb x:Name="BreadcrumbCtrl" Grid.Column="0"
								CurrentPath="{Binding SelectedFolder.FullPath, Mode=OneWay}"
								NavigateCommand="{Binding NavigateToPathCommand}"
								Margin="10,0,0,0"
								Height="35"
								NavigateSubCommand="{Binding NavigateToSubFolderCommand}"
								GoBackCommand="{Binding GoBackCommand}"
								GoForwardCommand="{Binding GoForwardCommand}"
								GoUpCommand="{Binding GoUpCommand}"
								CanGoBack="{Binding CanGoBack}"
								CanGoForward="{Binding CanGoForward}">
		</LRSCtrls:LRSBreadcrumb>
		<StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,10,0" Spacing="4" VerticalAlignment="Center">
			<AppBarButton x:Name="NewFolderButton" Label="新建文件夹"
						  Command="{Binding NewFolderCommand}"
						  ToolTipService.ToolTip="在当前目录创建新文件夹">
				<AppBarButton.Icon>
					<FontIcon Glyph="&#xE8B7;"/>
				</AppBarButton.Icon>
			</AppBarButton>
			<AppBarButton x:Name="NewFileButton" Label="新建文件"
						  Command="{Binding NewFileCommand}"
						  ToolTipService.ToolTip="在当前目录创建新文件（行为可在设置中切换）">
				<AppBarButton.Icon>
					<FontIcon Glyph="&#xE7C3;"/>
				</AppBarButton.Icon>
			</AppBarButton>
		</StackPanel>
	</Grid>
</Page>
