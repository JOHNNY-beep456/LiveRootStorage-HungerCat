<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LRS.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LRS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LRS.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="22"/>
                <TextBlock Text="搜索文件" FontSize="20" FontWeight="SemiBold"/>
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="CloseButton"
                    Click="OnCloseClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="关闭搜索面板"
                    Height="32" Padding="8,2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE894;" FontSize="14"/>
                    <TextBlock Text="关闭" FontSize="13"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 搜索输入与选项 -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchInput"
                     Grid.Column="0"
                     PlaceholderText="输入关键词（支持 * ? 通配符；不区分大小写）"
                     FontSize="14"
                     Padding="10,8,10,8"
                     KeyDown="OnSearchKeyDown"
                     Text="{Binding Search.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1"
                    x:Name="SearchButton"
                    Click="OnSearchClick"
                    Style="{StaticResource AccentButtonStyle}"
                    Height="36" Padding="14,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                    <TextBlock Text="搜索" FontSize="13"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 选项 + 搜索根目录 -->
        <Grid Grid.Row="2" Margin="0,4,0,0" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <CheckBox Content="包含子文件夹"
                          IsChecked="{Binding Search.IncludeSubfolders, Mode=TwoWay}"/>
                <CheckBox Content="匹配完整路径"
                          ToolTipService.ToolTip="勾选后，会在文件完整路径中搜索关键词"
                          IsChecked="{Binding Search.MatchFullPath, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="搜索根目录：" FontSize="13" Opacity="0.7" VerticalAlignment="Center"/>
                <Border BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SearchRootText"
                               Text="{Binding Search.SearchRoot, Mode=OneWay}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
                <TextBlock Text="（点击关闭后切换目录可修改）"
                           FontSize="11"
                           Opacity="0.55"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </StackPanel>

            <!-- 结果区 -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Search.StatusText}"
                               Foreground="#D6D6D6"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing Width="14" Height="14"
                                      IsActive="{Binding Search.IsSearching}"
                                      Visibility="{Binding Search.IsSearchingVisibility}"/>
                        <Button x:Name="ClearButton"
                                Click="OnClearClick"
                                Style="{StaticResource SubtleButtonStyle}"
                                Height="26" Padding="8,0"
                                ToolTipService.ToolTip="清空关键词与结果">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE75C;" FontSize="12"/>
                                <TextBlock Text="清空" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ListView x:Name="ResultsList"
                          Grid.Row="1"
                          ItemsSource="{Binding Search.Results}"
                          SelectionMode="Single"
                          DoubleTapped="OnResultDoubleTapped"
                          IsItemClickEnabled="False"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="4"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchResultItem">
                            <Grid Padding="6,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          FontFamily="Segoe Fluent Icons"
                                          Glyph="{x:Bind IconGlyph}"
                                          FontSize="22"
                                          VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               FontSize="11"
                                               Opacity="0.7"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="3"
                   Text="提示：双击结果跳转；通配符示例：*.txt、test*、*报告*"
                   FontSize="11"
                   Opacity="0.55"
                   Margin="0,4,0,0"/>
    </Grid>
</Page>
